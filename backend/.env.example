# SentinelLab Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is GITIGNORED — never commit it.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# Application Settings
APP_NAME=SentinelLab
APP_VERSION=1.0.0
DEBUG=true

# Database
# SQLite file path (relative to backend/ directory)
DATABASE_URL=sqlite:///./sentinellab.db

# API Settings
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API host and port (used by uvicorn)
API_HOST=127.0.0.1
API_PORT=8000

# Security Settings
# Secret key for any session/token operations (generate a random one)
SECRET_KEY=change-this-to-a-random-secret-key-before-any-use

# Lab Configuration
# URL of the vulnerable lab application (for health checks)
VULNERABLE_LAB_URL=http://127.0.0.1:5000

# Report Output Directory (relative to project root)
REPORTS_DIR=../reports

# Sample Data Directory (relative to project root)
SAMPLE_DATA_DIR=../sample-data
